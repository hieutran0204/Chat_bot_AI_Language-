# name: .env.example
# description: Environment variable template for RAG English Learning Chatbot

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Language AI Chatbot"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=language_ai
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=language_ai_db
DATABASE_URL=postgresql+asyncpg://language_ai:your_password_here@localhost:5432/language_ai_db

# ─── Ollama (Local LLM) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── HuggingFace ──────────────────────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Options: sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (multilingual)
#          BAAI/bge-large-en-v1.5 (English only, higher quality)
EMBEDDING_DIMENSION=768

# ─── RAG Configuration ────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5
MAX_CONTEXT_TOKENS=3000
CONVERSATION_HISTORY_LIMIT=5

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,txt

# ─── Embedding Provider ───────────────────────────────────────────────────────
# Options: huggingface | ollama
EMBEDDING_PROVIDER=huggingface

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | huggingface
LLM_PROVIDER=ollama

# ─── Redis (Phase 3 caching, optional) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
